# ==========================================
# Multimodal AI Chatbot Environment Config
# ==========================================

# Database Configuration (PostgreSQL)
# Standard PostgreSQL connection string.
# If PostgreSQL is not yet running locally, the backend automatically 
# provides an immediate local fallback to SQLite (multimodal_chatbot.db) so you can test instantly.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_chatbot
SQLITE_FALLBACK=True

# Multimodal LLM Configuration (Google Gemini / API Provider)
# Get a free key at: https://aistudio.google.com/app/apikey
# If left blank, the application will run in local intelligent fallback mode.
GEMINI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=text-embedding-004

# Web Search Configuration
# DuckDuckGo search is included out of the box with zero API keys required.
# Optional Tavily API Key:
SEARCH_API_KEY=
TAVILY_API_KEY=

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Server Bindings
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
