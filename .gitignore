# ==========================================
# Git Ignore Rules - Multimodal AI Chatbot
# ==========================================

# CRITICAL SECURITY: Never commit secrets or environment files!
.env
*.env
.env.*
!.env.example
backend/.env
backend/*.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
env/
ENV/
backend/venv/
backend/env/
.venv/

# Databases
*.db
*.sqlite
*.sqlite3
multimodal_chatbot.db
backend/multimodal_chatbot.db

# Uploads, Temporary Files & Generated Artifacts
uploads/*
!uploads/.gitkeep
backend/uploads/*
!backend/uploads/.gitkeep
backend/uploads/generated/*
!backend/uploads/generated/.gitkeep

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
frontend/dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing & Logs
*.log
.pytest_cache/
.coverage
htmlcov/
backend/tests/test_upload.txt

# IDEs & System
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
.gemini/
