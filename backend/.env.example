# ==========================================
# Multimodal AI Chatbot Environment Config
# ==========================================

# Database Configuration
# Default PostgreSQL URL (Standard port 5432)
# If PostgreSQL is not running or not installed, the application will automatically 
# fall back to a local SQLite database (multimodal_chatbot.db) so you can test immediately!
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/multimodal_chatbot
SQLITE_FALLBACK=True

# Multimodal AI Provider (Google Gemini)
# Obtain a free API key at: https://aistudio.google.com/app/apikey
# If left blank, the application will run in Demo/Offline mode with intelligent mock responses.
GEMINI_API_KEY=
LLM_API_KEY=
LLM_MODEL=gemini-flash-latest
EMBEDDING_MODEL=text-embedding-004

# Optional Web Search Provider
# DuckDuckGo search is built-in and free (no API key required).
# Optionally you can set SEARCH_API_KEY or TAVILY_API_KEY for Tavily search.
SEARCH_API_KEY=
TAVILY_API_KEY=

# File Upload Configuration
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=25

# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
